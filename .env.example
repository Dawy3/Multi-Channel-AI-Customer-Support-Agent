# AgentKit — Environment variables
# Copy this file as .env and fill in your data:
#   cp .env.example .env
#
# Claude Code helps you fill in these values during setup.
# NEVER upload the .env file to GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Get at: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── WhatsApp Provider ──────────────────────────────────────
# Options: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (if WHATSAPP_PROVIDER=meta) ────────────
# Set up at: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (if WHATSAPP_PROVIDER=twilio) ──────────────────
# Set up at: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Server ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Production (PostgreSQL on Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
